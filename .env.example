# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ascension

# Database
# DATABASE_URL is the only connection string read (by prisma.config.ts and src/lib/db/prisma.ts).
# npm run dev, db:migrate, db:deploy and db:studio all act on whatever it points at, so check it
# before running them: this default is the local Docker Postgres on host port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ascension?schema=public
# DIRECT_URL is not read by any current code (kept for CI/Compose parity); it does nothing.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/ascension?schema=public

# Auth.js - implemented in Phase 2
# AUTH_SECRET signs sessions and keys the HMAC of emailed codes. Required in production and keep it
# stable: rotating it signs everyone out and invalidates outstanding codes.
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Next.js Server Actions encryption key. Must be a base64-encoded 16, 24, or 32-byte AES key —
# generate once with `openssl rand -base64 32`. Required as a BUILD-TIME env var (not just
# runtime) in every deploy target that builds this app (Vercel project settings, and/or any
# Docker/Render build that runs `npm run build`). It must stay byte-identical across every
# future build/deploy: Next.js uses it to encrypt Server Action IDs, and rotating it (or leaving
# it unset, which makes Next.js mint a new random key per build) invalidates every Server Action
# a client's already-loaded JS still references — e.g. the Google sign-in button — producing
# "Server Action was not found on the server" errors for anyone with a tab open from before the
# rotation. Never rotate this casually.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Email delivery via Resend (sign-up verification codes, password-reset links, password-change
# codes, welcome email). Both are required in production (sending fails closed without them).
# In development, when BOTH are set, REAL email is sent: use mailboxes you control. When either is
# unset, codes/links are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Ascension <no-reply@your-verified-domain.example>"

# AI meal suggestions - implemented in Phase 8
OPENAI_API_KEY=

# Supabase storage - implemented in body photo phase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenFoodFacts
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org

# FatSecret
FATSECRET_ACCESS_TOKEN=FAT_SECRET_KEY
